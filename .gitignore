# Godot 4
.godot/
/android/

# gs-core is a separate repository. For local development, symlink it:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# Consumers copy both addons into their own project.
/addons/gs_core

# gs-server is OPTIONAL (console cvars) and linked only so the suite can run the cvar
# section against the real console; without it that section says so out loud.
/addons/gs_server

